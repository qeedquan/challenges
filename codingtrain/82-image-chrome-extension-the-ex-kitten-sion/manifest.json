{
	"manifest_version": 3,
	"name": "Chrome Exkittension",
	"version": "0.1",
	"web_accessible_resources": [
		{
			"resources": [
				"kittens/*.jpg"
			],
			"matches": [
				"<all_urls>"
			]
		}
	],
	"content_scripts": [
		{
			"matches": [
				"<all_urls>"
			],
			"js": [
				"kitten.js"
			]
		}
	],
	"permissions": [
		"storage",
		"activeTab"
	]
}
